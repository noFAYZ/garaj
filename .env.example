# Copy to .env at the REPO ROOT (not inside a package — the loader walks up to find it).

NODE_ENV=development
LOG_LEVEL=debug

# --- Required ---------------------------------------------------------------
# The only service the API genuinely needs. Either works:
#   Docker    postgresql://vehicleos:vehicleos@localhost:5432/vehicleos
#   Neon      postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://vehicleos:vehicleos@localhost:5432/vehicleos

# openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me-0000000000000000000

# --- Optional ---------------------------------------------------------------
# Redis. Only the API's production rate limiter uses it, to share one counter across
# instances; without it the counter is per-process. The worker does not use Redis.
REDIS_URL=

# Object storage. Two ways in; without either, the API runs and only the photo and document
# endpoints return 503.
#
# 1. Upstash Blob — S3-compatible, backed by Cloudflare R2. One token, short-lived
#    credentials the SDK refreshes itself. Takes precedence when set.
UPSTASH_BLOB_TOKEN=
#
# 2. A raw S3 bucket (R2, MinIO, S3). All four or none — partial configuration is rejected
#    at startup as a typo rather than silently disabling uploads.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# MinIO addresses buckets by path; R2 and S3 use a virtual host.
OBJECT_STORAGE_FORCE_PATH_STYLE=true

AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
# The landing site (apps/landing): where its buttons send people, and its own public URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3003
# Admin console access: comma-separated user ids (the console shows yours after sign-in).
ADMIN_USER_IDS=
API_HOST=0.0.0.0
API_PORT=3001

# Features gate themselves off when these are absent.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_BUSINESS=
STRIPE_PORTAL_CONFIGURATION=
OPENAI_API_KEY=
POSTHOG_KEY=
SENTRY_DSN=

# Background removal for vehicle thumbnails (Pixelcut). Without a key the worker leaves
# photos alone and a card shows the original — a plainer thumbnail, not a broken one.
# Key from pixelcut.ai → API → keys.
BG_REMOVAL_URL=https://api.developer.pixelcut.ai/v1/remove-background
# BG_REMOVAL_API_KEY=sk_...

# AI (Architecture.md §41). Named by role, not vendor — the provider is one adapter.
# Gemini's free tier: aistudio.google.com → Get API key.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.1-flash-lite
# Asked when AI_MODEL fails; leave empty for no fallback.
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
# AI_API_KEY=

# Manufacturer logos (logo.dev). A publishable key — it is meant to be in the page.
# Without it every make renders as its initial, which is a plainer picker, not a broken one.
# Key from logo.dev → Dashboard → API keys (publishable, pk_...).
# NEXT_PUBLIC_LOGO_DEV_TOKEN=

# The same logo.dev key for the mobile app. Expo reads it from apps/mobile/.env, not this file.
# EXPO_PUBLIC_LOGO_DEV_TOKEN=

# Notification delivery (optional; each channel is skipped and logged when unset)
RESEND_API_KEY=
# Must be on a domain verified in Resend (resend.com/domains), or every send is refused with a 403.
EMAIL_FROM="Garaj <reminders@garaj.app>"
EXPO_ACCESS_TOKEN=
