    "@sinclair/typebox": "^0.34.13",
    "@upstash/blob": "^0.0.4",
    "@vehicle-os/config": "workspace:*",
    "@vehicle-os/contracts": "workspace:*",
    "@vehicle-os/database": "workspace:*",
    "@vehicle-os/domain": "workspace:*",
