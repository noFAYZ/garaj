{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.20.0",
      "pnpm": "11.12.0",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "API_URL": "https://garaj-api-p3k1.onrender.com"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production"
    },
    "share": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://drops-costs-vanilla-completing.trycloudflare.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
