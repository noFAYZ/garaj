{
  "expo": {
    "name": "Garaj",
    "slug": "vehicle-os",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vehicleos",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.garajjos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.garajjos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Garaj uses your photos to attach receipts, documents and pictures of your vehicles.",
          "cameraPermission": "Garaj uses the camera to photograph receipts, documents and your vehicles.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#090705"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "benzapps",
          "project": "garaj-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "apiUrl": "https://garaj-api-p3k1.onrender.com",
      "sentryDsn": "https://4b8ed523a0b6e4c0c999663d83f0f5ee@o4512457247031296.ingest.us.sentry.io/4512457259155456",
      "revenuecat": {
        "android": "",
        "ios": ""
      },
      "eas": {
        "projectId": "49ae75e0-972d-4afc-bdbd-93eadcfdd53e"
      }
    },
    "owner": "nofayz"
  }
}
