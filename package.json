{
  "name": "vehicle-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @vehicle-os/web test:e2e",
    "db:generate": "pnpm --filter @vehicle-os/database db:generate",
    "db:migrate": "pnpm --filter @vehicle-os/database db:migrate",
    "db:push": "pnpm --filter @vehicle-os/database db:push",
    "db:studio": "pnpm --filter @vehicle-os/database db:studio",
    "db:seed": "pnpm --filter @vehicle-os/database db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@vehicle-os/prettier-config": "workspace:*",
    "@vehicle-os/tsconfig": "workspace:*",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "prettier": "@vehicle-os/prettier-config"
}
